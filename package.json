{
  "name": "web-mux",
  "version": "0.1.0",
  "description": "Configurable web search, content extraction, grounded answers, and research through interchangeable providers, with a TypeScript library, web CLI, and pi extension.",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "example-config.json",
    "examples"
  ],
  "keywords": [
    "web-mux",
    "web-cli",
    "typescript-library",
    "pi-package",
    "pi-extension",
    "coding-agent",
    "web-search",
    "web-contents",
    "web-answer",
    "web-research",
    "provider-routing",
    "brave",
    "claude",
    "cloudflare",
    "codex",
    "custom",
    "exa",
    "firecrawl",
    "gemini",
    "linkup",
    "ollama",
    "openai",
    "parallel",
    "perplexity",
    "serper",
    "tavily",
    "valyu"
  ],
  "author": "mavam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mavam/web-mux.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./dist/pi.js"
    ]
  },
  "bin": {
    "web": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pi": {
      "types": "./dist/pi.d.ts",
      "import": "./dist/pi.js"
    },
    "./config.schema.json": "./dist/config.schema.json"
  },
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.ts src/cli.ts src/pi.ts --bundle --splitting --format=esm --platform=node --target=node22 --packages=external --outdir=dist && tsc --project tsconfig.build.json && cp src/config.schema.json dist/config.schema.json && chmod +x dist/cli.js",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "check": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "smoke:live": "npm run build && node scripts/live-smoke.mjs",
    "smoke:package": "node scripts/package-smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.215",
    "@google/genai": "^2.12.0",
    "@mendable/firecrawl-js": "^4.30.1",
    "@openai/codex-sdk": "^0.144.6",
    "@perplexity-ai/perplexity_ai": "^0.37.0",
    "@tavily/core": "^0.7.6",
    "cloudflare": "^7.0.0",
    "exa-js": "^2.16.0",
    "linkup-sdk": "^3.2.8",
    "openai": "^6.48.0",
    "parallel-web": "^1.1.0",
    "typebox": "^1.3.6",
    "valyu-js": "^2.9.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@earendil-works/pi-ai": "^0.80.10",
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@earendil-works/pi-tui": "^0.80.10",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
