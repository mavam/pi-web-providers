{
  "name": "webfox",
  "version": "0.1.0",
  "description": "Search the web, extract pages, get grounded answers, and run deep research with the web CLI, a TypeScript library, and a pi extension. Bring your own providers and API keys.",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "assets/webfox-lockup.png",
    "assets/webfox-lockup-dark.png",
    "docs/cli-experience.md",
    "docs/provider.md",
    "docs/reference.md",
    "LICENSE",
    "example-config.yaml",
    "examples"
  ],
  "keywords": [
    "webfox",
    "web-cli",
    "typescript-library",
    "pi-package",
    "pi-extension",
    "coding-agent",
    "web-search",
    "web-contents",
    "web-answer",
    "web-research",
    "provider-routing",
    "brave",
    "cloudflare",
    "custom",
    "exa",
    "firecrawl",
    "gemini",
    "linkup",
    "ollama",
    "openai",
    "parallel",
    "perplexity",
    "serper",
    "tavily",
    "valyu"
  ],
  "author": "mavam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mavam/pi-web-providers.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./dist/pi.js"
    ]
  },
  "bin": {
    "web": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pi": {
      "types": "./dist/pi.d.ts",
      "import": "./dist/pi.js"
    },
    "./config.schema.json": "./dist/config.schema.json"
  },
  "scripts": {
    "build": "rm -rf dist && esbuild index=src/index.ts cli=src/cli.ts pi=src/pi.ts generate-schema=scripts/generate-schema.ts --bundle --splitting --format=esm --platform=node --target=node22 --packages=external --outdir=dist && node dist/generate-schema.js && biome format --write src/config.schema.json >&2 && rm dist/generate-schema.js && tsc --project tsconfig.build.json && cp src/config.schema.json dist/config.schema.json && chmod +x dist/cli.js",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "check": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "smoke:live": "npm run build && node scripts/live-smoke.mjs",
    "smoke:package": "node scripts/package-smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@mendable/firecrawl-js": "^4.38.0",
    "@perplexity-ai/perplexity_ai": "^0.38.5",
    "@tavily/core": "^0.7.9",
    "cloudflare": "^7.1.0",
    "commander": "^14.0.3",
    "exa-js": "^2.19.0",
    "linkup-sdk": "^3.6.0",
    "openai": "^7.10.0",
    "parallel-web": "^1.3.3",
    "picocolors": "^1.1.1",
    "typebox": "^1.3.6",
    "valyu-js": "^2.10.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
